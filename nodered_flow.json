    {
        "id": "mqtt-detection-in",
        "type": "mqtt in",
        "z": "birdwatch-tab",
        "name": "birdwatch/detection",
        "topic": "birdwatch/detection",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt-broker-config",
        "inputs": 0,
        "x": 370,
        "y": 780,
        "wires": [
            [
                "parse-detection"
            ]
        ]
    },
    {
        "id": "parse-detection",
        "type": "function",
        "z": "birdwatch-tab",
        "name": "Format for HA",
        "func": "const d = msg.payload;\nconst confidence = Math.round(d.confidence * 100);\nmsg.payload = {\n    event_type: 'bird_detected',\n    event_data: {\n        common_name: d.common_name,\n        species:     d.species,\n        confidence:  confidence,\n        camera:      d.camera,\n        timestamp:   d.timestamp\n    }\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 780,
        "wires": [
            [
                "update-sensor",
                "detection-debug",
                "ha-fire-event"
            ]
        ]
    },
    {
        "id": "update-sensor",
        "type": "function",
        "z": "birdwatch-tab",
        "name": "Update HA sensor",
        "func": "const d = msg.payload.event_data;\nmsg.payload = {\n    state: d.common_name,\n    attributes: {\n        species:       d.species,\n        confidence:    d.confidence + '%',\n        camera:        d.camera,\n        last_seen:     d.timestamp,\n        friendly_name: 'Last Bird Detected'\n    }\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 970,
        "y": 780,
        "wires": [
            [
                "82d4a11b5de52eb5"
            ]
        ]
    },
