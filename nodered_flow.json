  {
    "id": "comment-mqtt",
    "type": "comment",
    "z": "birdwatch-tab",
    "name": "\u2500\u2500 MQTT: Detections \u2192 HA Events \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
    "info": "",
    "x": 200,
    "y": 430
  },
  {
    "id": "mqtt-detection-in",
    "type": "mqtt in",
    "z": "birdwatch-tab",
    "name": "birdwatch/detection",
    "topic": "birdwatch/detection",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt-broker-config",
    "x": 170,
    "y": 490,
    "wires": [
      [
        "parse-detection"
      ]
    ]
  },
  {
    "id": "parse-detection",
    "type": "function",
    "z": "birdwatch-tab",
    "name": "Format for HA",
    "func": "const d = msg.payload;\nconst confidence = Math.round(d.confidence * 100);\nmsg.payload = {\n    event_type: 'bird_detected',\n    event_data: {\n        common_name: d.common_name,\n        species:     d.species,\n        confidence:  confidence,\n        camera:      d.camera,\n        timestamp:   d.timestamp\n    }\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 490,
    "wires": [
      [
        "ha-fire-event",
        "update-sensor",
        "detection-debug"
      ]
    ]
  },
  {
    "id": "ha-fire-event",
    "type": "api-call-service",
    "z": "birdwatch-tab",
    "name": "Fire HA event",
    "server": "ha-server",
    "version": 5,
    "debugenabled": false,
    "domain": "homeassistant",
    "service": "fire_event",
    "areaId": [],
    "deviceId": [],
    "entityId": [],
    "data": "{\"event_type\": \"bird_detected\", \"event_data\": {{payload.event_data}}}",
    "dataType": "jsonata",
    "mergeContext": "",
    "mustacheAltTags": false,
    "outputProperties": [],
    "queue": "none",
    "x": 620,
    "y": 470,
    "wires": [
      []
    ]
  },
  {
    "id": "update-sensor",
    "type": "function",
    "z": "birdwatch-tab",
    "name": "Update HA sensor",
    "func": "const d = msg.payload.event_data;\nmsg.payload = {\n    state: d.common_name,\n    attributes: {\n        species:       d.species,\n        confidence:    d.confidence + '%',\n        camera:        d.camera,\n        last_seen:     d.timestamp,\n        friendly_name: 'Last Bird Detected'\n    }\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 620,
    "y": 530,
    "wires": [
      [
        "ha-entity-update"
      ]
    ]
  },
  {
    "id": "ha-entity-update",
    "type": "ha-entity",
    "z": "birdwatch-tab",
    "name": "last_bird_detected",
    "server": "ha-server",
    "version": 2,
    "debugenabled": false,
    "outputs": 1,
    "entityType": "sensor",
    "config": [
      {
        "property": "name",
        "value": "Last Bird Detected"
      },
      {
        "property": "device_class",
        "value": ""
      },
      {
        "property": "icon",
        "value": "mdi:bird"
      },
      {
        "property": "unit_of_measurement",
        "value": ""
      }
    ],
    "resend": true,
    "outputLocation": "payload",
    "outputLocationType": "msg",
    "inputOverride": "allow",
    "outputOnStateChange": false,
    "x": 840,
    "y": 530,
    "wires": [
      []
    ]
