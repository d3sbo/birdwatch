  {
    "id": "fn-start-container",
    "type": "function",
    "z": "birdwatch-tab",
    "name": "Start Container",
    "func": "msg.url = env.get(\"DOCKER_DESKTOP\") + \"/start-birdwatch\";\nmsg.method = \"GET\";\nmsg.headers = {};\nnode.warn(\"Starting birdwatch container via DockerControl...\");\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 210,
    "wires": [
      [
        "http-start"
      ]
    ]
  },
  {
    "id": "fn-stop-container",
    "type": "function",
    "z": "birdwatch-tab",
    "name": "Stop Container",
    "func": "msg.url = env.get(\"DOCKER_DESKTOP\") + \"/stop-birdwatch\";\nmsg.method = \"GET\";\nmsg.headers = {};\nnode.warn(\"Stopping birdwatch container via DockerControl...\");\nreturn msg;",
    "outputs": 1,
