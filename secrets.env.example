# Copy to secrets.env and fill in. Loaded via env_file in docker-compose.yml.

# Cameras - add as many as you have (CAMERA_1, CAMERA_2, ...)
# go2rtc HTTP stream example; RTSP URLs work too
CAMERA_1_URL=http://192.168.1.50:1984/api/stream.mp4?src=camera1_sub
CAMERA_1_NAME=Camera 1
CAMERA_2_URL=http://192.168.1.50:1984/api/stream.mp4?src=camera2_sub
CAMERA_2_NAME=Camera 2

# MQTT broker (Home Assistant)
MQTT_HOST=192.168.1.10
MQTT_PASSWORD=changeme

# Location, used by BirdNET to filter likely species
LATITUDE=51.5074
LONGITUDE=-0.1278
